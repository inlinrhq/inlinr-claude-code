#!/bin/sh
# Trigger an Inlinr AI sync. That is the entire plugin.
#
# All the work — finding Claude Code's transcripts, counting tokens, computing
# line changes, resolving the git remote, rate-limiting, queueing offline —
# lives in the `inlinr` CLI (`internal/ai/`). Keeping the parsing there means
# one implementation covers Claude Code in the terminal, in Claude Desktop and
# inside VS Code, and this hook stays a trigger. WakaTime's Claude plugin has
# the same shape for the same reason.
#
# Two rules this script must never break:
#
#   1. **Never fail the turn.** A Stop hook that exits non-zero interrupts the
#      user's work. Time tracking is never worth that, so every path exits 0.
#   2. **Never print to stdout.** Hook output is surfaced to the user; a
#      tracker that chats after every turn is a tracker people uninstall.
#      Diagnostics go to the log file the CLI already owns.

set -u

PLUGIN_VERSION="0.1.0"
LOG_DIR="${HOME}/.inlinr"
LOG_FILE="${LOG_DIR}/claude-code-hook.log"

log() {
  mkdir -p "$LOG_DIR" 2>/dev/null || return 0
  printf '%s %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$1" >>"$LOG_FILE" 2>/dev/null || true
}

# Resolve the CLI. PATH first, then the locations the VS Code extension and the
# installer use, so a user who only ever installed the extension still syncs.
find_cli() {
  if command -v inlinr >/dev/null 2>&1; then
    command -v inlinr
    return 0
  fi
  for candidate in \
    "${INLINR_CLI:-}" \
    "${HOME}/.inlinr/bin/inlinr" \
    "${HOME}/.local/bin/inlinr" \
    "/usr/local/bin/inlinr"
  do
    [ -n "$candidate" ] && [ -x "$candidate" ] && { printf '%s' "$candidate"; return 0; }
  done
  return 1
}

CLI="$(find_cli)" || {
  # Not installed is a normal state, not an error — the user may have added the
  # plugin before installing the CLI. Say so once in the log and move on.
  log "inlinr CLI not found on PATH; skipping sync"
  exit 0
}

# `sync-ai` is idempotent and cheap: a watermark means it only reads transcript
# lines written since last time, and a lock means concurrent editors can't
# double-count. Safe to call on every turn.
"$CLI" sync-ai \
  --plugin "claude-code-inlinr/${PLUGIN_VERSION}" \
  --log-file "$LOG_FILE" \
  >/dev/null 2>>"$LOG_FILE" || log "sync-ai exited non-zero (see above)"

exit 0
